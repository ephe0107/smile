# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres. Locally this is the docker container; in production use Neon's
# POOLED connection string (the host containing "-pooler"), which multiplexes
# connections so several app instances don't exhaust the database.
DATABASE_URL=postgres://smile:smile@localhost:5432/smile

# Where the app is reachable. Used to validate the Origin header on any
# request that changes data, which is what stops cross-site form posts.
APP_ORIGIN=http://localhost:3000

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this signs every existing session out.
SESSION_SECRET=

# Transactional email for sign-in codes (https://resend.com). Without it the
# server prints codes to the log instead, which is fine for local development
# and must never be how production runs.
RESEND_API_KEY=
MAIL_FROM="Smile Check <noreply@example.com>"

# Optional
PORT=3000
HOST=127.0.0.1
